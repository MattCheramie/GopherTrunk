/bin/
/dist/
# `go build ./...` without -o drops a `gophertrunk` binary at the
# repo root; the canonical build location is bin/gophertrunk via
# `make build`. Don't track the stray.
/gophertrunk
*.test
*.out
*.prof
# Daemon single-instance flock (created at <configdir>/.gophertrunk.lock
# at startup, removed on clean shutdown — see CHANGELOG "Single-instance
# lock" entry). Leaks into the working tree if a contributor runs
# `gophertrunk -config config.example.yaml` from the repo root.
.gophertrunk.lock
*.cfile
!**/testdata/**/*.cfile
.idea/
.vscode/
*.swp
.DS_Store
# Operator-local env files (not read by the daemon, but contributors
# occasionally drop secrets here while iterating on streaming creds).
.env
.env.*
# Jekyll build output and caches for the docs site (docs/). The site is
# built and deployed by .github/workflows/pages.yml; the generated
# _site/ is an artifact and must never be committed.
docs/_site/
.jekyll-cache/
.jekyll-metadata
.sass-cache/
# The landing page is synthesized from README.md at build time
# (.github/scripts/synthesize_home.sh), so the file isn't duplicated in the repo.
docs/index.md
video/_render/
